# PostgreSQL
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=password
PG_DB_NAME=outfit_recomendation

# Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model IDs (configurable; verify availability with your key via
#   GET https://generativelanguage.googleapis.com/v1beta/models?key=YOUR_KEY )
# Text analysis / reasoning model. "gemini-flash-latest" always points to the
# current stable Flash and avoids per-version deprecations.
GEMINI_TEXT_MODEL=gemini-flash-latest
# Image editing model (Nano Banana family)
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# App
APP_HOST=0.0.0.0
APP_PORT=8000
PUBLIC_DIR=public
